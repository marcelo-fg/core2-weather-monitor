# Middleware environment variables — copy to ``.env`` for local development.
# In production these are passed to Cloud Run via ``--update-env-vars``.
# NEVER commit a ``.env`` file with real values: ``.env`` is in .gitignore.

# ---- Google Cloud project (BigQuery, Cloud TTS, Cloud STT) -----------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# When using a user ADC (gcloud auth application-default login), the client
# libraries bill API usage to the quota project of the ADC by default.
# Force it onto your GCP project here, otherwise TTS/STT may return 403.
GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id

# Path to a service-account JSON or user ADC file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# ---- BigQuery ---------------------------------------------------------------
BIGQUERY_DATASET=weather_monitor
BIGQUERY_TABLE=sensor_readings

# ---- OpenWeatherMap --------------------------------------------------------
OPENWEATHER_API_KEY=your-openweathermap-key
DEFAULT_LOCATION=Lausanne,CH
TIMEZONE_OFFSET=2

# ---- Gemini (LLM) ----------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Text-to-Speech --------------------------------------------------------
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Journey-F
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0
TTS_SAMPLE_RATE_HZ=24000
# /tmp is writable on Cloud Run, ``static/audio`` is fine locally.
AUDIO_CACHE_DIR=/tmp/tts_cache
RATE_LIMIT_SECONDS=3600

# ---- Speech-to-Text --------------------------------------------------------
STT_LANGUAGE_CODE=en-US
STT_SAMPLE_RATE_HZ=8000
