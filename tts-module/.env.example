# =========================================================================
# Exemple de configuration des variables d'environnement
# =========================================================================
# Pour l'utiliser :
#   1. Copie ce fichier en ".env"    ->   cp .env.example .env
#   2. Adapte les valeurs si besoin.
#
# IMPORTANT : le fichier ".env" ne doit JAMAIS être commité sur git
# (il est déjà ignoré dans .gitignore). Il peut contenir des infos sensibles.

# --- Google Cloud (Text-to-Speech + Speech-to-Text) ---
# Chemin vers ta clé de compte de service Google (fichier JSON).
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# --- Paramètres de la voix ---
TTS_LANGUAGE_CODE=fr-FR
TTS_VOICE_NAME=fr-FR-Wavenet-C
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0
TTS_SAMPLE_RATE_HZ=24000

# --- Cache des fichiers audio ---
AUDIO_CACHE_DIR=static/audio

# --- Rate-limiting (en secondes ; 3600 = 1 heure) ---
RATE_LIMIT_SECONDS=3600

# --- Speech-to-Text (reconnaissance vocale, endpoint /listen) ---
STT_LANGUAGE_CODE=fr-FR
STT_SAMPLE_RATE_HZ=8000

# --- LLM Google Gemini (mode conversation, endpoint /listen) ---
# Clé API Gemini GRATUITE a creer ici : https://aistudio.google.com/apikey
GEMINI_API_KEY=remplace-par-ta-cle-gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Serveur Flask ---
FLASK_HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=false
